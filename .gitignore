
# Build output
/target/

# Environment variables and secrets
.env
.env.*
!.env.example

# IDE settings
.idea/
.vscode/

# Operating system files
.DS_Store
Thumbs.db

# Logs
*.log

# Temporary files
*.tmp

# Local configuration
config.local.toml


# Packaging tools downloaded on demand
/.tools/

