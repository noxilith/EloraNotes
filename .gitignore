/dist/

# Screenshots taken while working on the UI; the one the README shows lives in assets/
/screenshots/

# Local assistant settings
.claude/

# The iPhone app: built output, and the Xcode project that is generated from ios/project.yml.
/ios/core/target/
/ios/build/
/ios/Frameworks/
/ios/Generated/
/ios/*.xcodeproj/
